generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Empresa {
  id                Int            @id @default(autoincrement())
  nome              String
  cnpj              String         @unique
  telefone          String?
  ativa             Boolean        @default(true)
  criadoEm          DateTime       @default(now())
  fusoHorario       String         @default("America/Sao_Paulo") @db.VarChar(64)
  aberturaMin       Int            @default(540)
  fechamentoMin     Int            @default(1140)
  diasFuncionamento Json           @default(dbgenerated("(json_array(1,2,3,4,5,6))"))
  clientes          Cliente[]
  profissionais     Profissional[]
  servicos          Servico[]
  agendamentos      Agendamento[]

  @@map("empresas")
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  criadoEm     DateTime      @default(now())
  empresaId    Int
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agendamentos Agendamento[]

  @@unique([id, empresaId])
  @@unique([empresaId, telefone])
  @@index([empresaId, nome, id])
  @@map("clientes")
}

model Profissional {
  id           Int           @id @default(autoincrement())
  nome         String
  ativo        Boolean       @default(true)
  empresaId    Int
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agendamentos Agendamento[]

  @@unique([id, empresaId])
  @@index([empresaId, ativo, nome, id])
  @@map("profissionais")
}

model Servico {
  id           Int                  @id @default(autoincrement())
  nome         String
  preco        Decimal              @db.Decimal(10, 2)
  duracaoMin   Int
  ativo        Boolean              @default(true)
  empresaId    Int
  empresa      Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agendamentos AgendamentoServico[]

  @@unique([id, empresaId])
  @@index([empresaId, ativo, nome, id])
  @@map("servicos")
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
  FALTOU
}

model Agendamento {
  id             Int                  @id @default(autoincrement())
  inicio         DateTime
  fim            DateTime
  status         StatusAgendamento    @default(AGENDADO)
  criadoEm       DateTime             @default(now())
  empresaId      Int
  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chaveOperacao  String?              @db.VarChar(36)
  hashPedido     String?              @db.Char(64)
  clienteId      Int
  cliente        Cliente              @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  profissionalId Int
  profissional   Profissional         @relation(fields: [profissionalId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  servicos       AgendamentoServico[]

  @@unique([id, empresaId])
  @@unique([empresaId, chaveOperacao])
  @@index([empresaId, status, inicio, id])
  @@index([empresaId, profissionalId, inicio, fim])
  @@index([clienteId, empresaId])
  @@index([profissionalId, empresaId])
  @@map("agendamentos")
}

model AgendamentoServico {
  precoCobrado         Decimal     @db.Decimal(10, 2)
  nomeContratado       String
  duracaoContratadaMin Int
  empresaId            Int
  servicoId            Int
  servico              Servico     @relation(fields: [servicoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  agendamentoId        Int
  agendamento          Agendamento @relation(fields: [agendamentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@id([agendamentoId, servicoId])
  @@index([servicoId, empresaId])
  @@index([agendamentoId, empresaId])
  @@map("agendamento_servicos")
}
